{
  "name": "dshbot",
  "description": "Sidebar bot contacts and group rooms for DeepSeek Harness. Standalone dsh plugin; also developed inside Deepseek-Harness-Desktop.",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChisaAlter/dshbot.git"
  },
  "homepage": "https://github.com/ChisaAlter/dshbot#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "bots",
    "group-chat"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.7 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-subagent": "^0.1.0-rc.7 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7 || ^0.1.1-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./ask-participant": "./lib/ask-participant.js",
    "./agent-messaging": "./lib/agent-messaging.js",
    "./group-chat": "./lib/group-chat.js",
    "./group-chat-host": "./lib/group-chat-host.js",
    "./room-preset": "./lib/room-preset.js",
    "./memory": "./lib/memory.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "presets",
    "cordis.patch.yml"
  ]
}
