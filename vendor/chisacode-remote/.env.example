# ChisaCode 环境变量示例
# 复制本文件为 .env 并按需填值。所有变量均为可选；下面列出的占位值是默认行为或常见示例，不要填入敏感真实值。
# 注意：ChisaCode 不存在 CHISACODE_AUTH_TOKEN 变量，守护进程的共享密钥通过 CHISACODE_PASSWORD 配置。

# ─────────────────────────────────────────────────────────────
# 核心运行时
# ─────────────────────────────────────────────────────────────

# ChisaCode 数据目录，存放 agents.json、config.json、daemon.log、密钥对等运行时状态。
# 默认 ~/.chisacode；从 git worktree 启动 npm run dev 时会派生 ~/.chisacode-<worktree-name>。
CHISACODE_HOME=

# 守护进程监听地址。支持 host:port、/path/to/socket、unix:///path/to/socket。
# 默认 127.0.0.1:6767。绑定到 0.0.0.0 等非环回地址时强烈建议同时设置 CHISACODE_PASSWORD。
CHISACODE_LISTEN=127.0.0.1:6767

# 守护进程可选共享密钥（明文写入，启动时会 bcrypt 哈希）。
# 配置后每个 HTTP 请求需带 `Authorization: Bearer <password>`，
# WebSocket 升级需带 `Sec-WebSocket-Protocol: chisacode.bearer.<password>` 子协议。
# 仅适用于直连 TCP 场景；不可替代 relay 的端到端加密。
CHISACODE_PASSWORD=

# Host 头白名单（逗号分隔），用于防 DNS rebinding。以 `.` 开头的条目匹配域名及其子域；值为 `true` 时禁用白名单。
# 默认仅接受 localhost、*.localhost 与字面量 IP。
CHISACODE_HOSTNAMES=

# CHISACODE_HOSTNAMES 的已弃用别名，仍可工作但建议使用新名。
CHISACODE_ALLOWED_HOSTS=

# 覆盖守护进程稳定 ID（默认首次启动时生成并持久化）。主要供测试使用。
CHISACODE_SERVER_ID=

# 设为 1 表示当前进程由 supervisor 派生，避免子进程再次自启动 supervisor。通常无需手动设置。
CHISACODE_SUPERVISED=

# 设为 1 表示守护进程由桌面应用托管（影响 pid-lock 与生命周期报告）。通常无需手动设置。
CHISACODE_DESKTOP_MANAGED=

# CLI 界面语言覆盖（如 zh-CN、en）。未设置时按 i18n 默认逻辑推断。
CHISACODE_LANG=

# ─────────────────────────────────────────────────────────────
# 日志与调试
# ─────────────────────────────────────────────────────────────

# 全局日志级别：trace | debug | info | warn | error。设为 trace 可输出 provider/session/agent-manager 全量轨迹。
CHISACODE_LOG_LEVEL=info

# 覆盖 config.json 中 log.console.level / log.file.level / log.file.path
CHISACODE_LOG_CONSOLE_LEVEL=
CHISACODE_LOG_FILE_LEVEL=
CHISACODE_LOG_FILE_PATH=

# 日志文件轮转覆盖。默认 10m × 3 份。代码实际使用以下两个变量名：
CHISACODE_LOG_ROTATE_SIZE=
CHISACODE_LOG_ROTATE_COUNT=

# 设为 1 开启听写/STT/TTS 调试录音，写入 `${cwd}/.debug/recordings/`。
CHISACODE_DICTATION_DEBUG=

# 设为 1 开启 Claude SDK 流式 trace 级别逐 token 日志。
CHISACODE_CLAUDE_DEBUG=

# ─────────────────────────────────────────────────────────────
# Provider API Key 与凭据
# ─────────────────────────────────────────────────────────────
# ChisaCode 自身不存储/转发 provider 密钥；以下变量由被启动的 provider CLI 直接读取。
# 仅列出 packages/server/.env.example 已采用或源码中显式读取的占位。

# OpenAI（GPT、Whisper STT、TTS、Realtime 语音）
OPENAI_API_KEY=
# 自定义 OpenAI 兼容网关基址（Codex 等会读取）
OPENAI_BASE_URL=
# OpenAI Realtime 转写端点（默认 wss://api.openai.com/v1/realtime?intent=transcription）
OPENAI_REALTIME_URL=

# Anthropic / Claude Code
ANTHROPIC_API_KEY=
# Claude Code OAuth 令牌（作为 API key 的替代）
CLAUDE_CODE_OAUTH_TOKEN=
# 自定义默认 Anthropic 模型 / sonnet 模型
ANTHROPIC_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
# 切换 Claude Code 到 Bedrock / Vertex 后端（=1 / =true）
CLAUDE_CODE_USE_BEDROCK=
CLAUDE_CODE_USE_VERTEX=
# Claude Code 配置目录，默认 ~/.claude
CLAUDE_CONFIG_DIR=

# OpenRouter（部分 provider 适配时会读取）
OPENROUTER_API_KEY=

# Codex / Codex App Server
# Codex 主目录，默认 ~/.codex
CODEX_HOME=

# Pi (ACP) 命令名，默认 pi
PI_COMMAND=
PI_ACP_PI_COMMAND=

# ─────────────────────────────────────────────────────────────
# 语音与听写
# ─────────────────────────────────────────────────────────────

# 语音 agent 使用的 LLM provider：claude | codex | opencode
CHISACODE_VOICE_LLM_PROVIDER=

# STT / TTS provider 选择：local | openai
CHISACODE_DICTATION_STT_PROVIDER=
CHISACODE_VOICE_STT_PROVIDER=
CHISACODE_VOICE_TTS_PROVIDER=

# 本地模型存放目录
CHISACODE_LOCAL_MODELS_DIR=

# 本地 STT/TTS 模型与音色/语速
CHISACODE_DICTATION_LOCAL_STT_MODEL=
CHISACODE_VOICE_LOCAL_STT_MODEL=
CHISACODE_VOICE_LOCAL_TTS_MODEL=
CHISACODE_VOICE_LOCAL_TTS_SPEAKER_ID=
CHISACODE_VOICE_LOCAL_TTS_SPEED=

# 听写/语音 STT 语言代码
CHISACODE_DICTATION_LANGUAGE=
CHISACODE_VOICE_LANGUAGE=

# 听写静音峰值阈值（默认 300）
CHISACODE_DICTATION_SILENCE_PEAK_THRESHOLD=
# 听写自动提交秒数
CHISACODE_DICTATION_AUTO_COMMIT_SECONDS=
# 听写转写提示词（给 STT 模型的上下文 prompt）
CHISACODE_DICTATION_TRANSCRIPTION_PROMPT=
# STT 批次提交间隔秒数
CHISACODE_STT_BATCH_COMMIT_EVERY_SECONDS=

# 设为 1 / true 在配对完成时显示 QR 码
CHISACODE_PAIRING_QR=

# OpenAI TTS 配置（与 packages/server/.env.example 一致）
TTS_VOICE=alloy
# 可选值：alloy, echo, fable, onyx, nova, shimmer
TTS_MODEL=tts-1
# 可选值：tts-1（更快）、tts-1-hd（更高品质）

# ─────────────────────────────────────────────────────────────
# Git 与文件监视
# ─────────────────────────────────────────────────────────────

# git 并发操作数（默认 8）
CHISACODE_GIT_CONCURRENCY=

# Linux 下 workspace git 服务 readdir 并发（默认 16）
CHISACODE_LINUX_WATCH_READDIR_CONCURRENCY=

# ─────────────────────────────────────────────────────────────
# 网络发现与连接
# ─────────────────────────────────────────────────────────────

# 手动覆盖主 LAN IP（用于连接邀约展示）
CHISACODE_PRIMARY_LAN_IP=

# CLI 连接守护进程时使用的 host:port（也可通过 --host 参数传入）
CHISACODE_HOST=

# ─────────────────────────────────────────────────────────────
# 桌面端（Electron）/ 开发工作流
# ─────────────────────────────────────────────────────────────

# 设为 1 开启桌面端调试输出
CHISACODE_DEBUG=

# 设为 1 禁用单实例锁，便于同时运行多个 dev 实例
CHISACODE_DISABLE_SINGLE_INSTANCE_LOCK=

# 桌面应用名称覆盖（主要用于测试）
CHISACODE_TEST_APP_NAME=

# Electron userData 目录覆盖
CHISACODE_ELECTRON_USER_DATA_DIR=

# 附加 Chromium 命令行标志
CHISACODE_ELECTRON_FLAGS=

# Chromium 远程调试端口（默认 9223）
CHISACODE_ELECTRON_REMOTE_DEBUGGING_PORT=

# dev 模式下 Expo dev server URL（默认 http://localhost:8081）
EXPO_DEV_URL=

# 设为 1 表示当前 CLI 由桌面应用派生（影响 daemon passthrough 行为）
CHISACODE_DESKTOP_CLI=

# npm run dev 从 worktree 派生 home 时的种子来源与重置开关
CHISACODE_DEV_SEED_HOME=
CHISACODE_DEV_RESET_HOME=

# ─────────────────────────────────────────────────────────────
# 移动 / Web 应用
# ─────────────────────────────────────────────────────────────

# Expo web/native app 暴露的本地守护进程地址（公开前缀 EXPO_PUBLIC_*）
EXPO_PUBLIC_LOCAL_DAEMON=