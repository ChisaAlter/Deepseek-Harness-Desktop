#!/bin/sh
set -eu

SCRIPT_PATH=$0
case "$SCRIPT_PATH" in
  /*) ;;
  *) SCRIPT_PATH="$(pwd)/$SCRIPT_PATH" ;;
esac

# Follow symlinks so `/usr/local/bin/chisacode` resolves back into the app bundle.
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
  LINK_TARGET=$(readlink "$SCRIPT_PATH")
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH="$LINK_TARGET" ;;
    *) SCRIPT_PATH="${SCRIPT_DIR}/${LINK_TARGET}" ;;
  esac
done

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
RESOURCES_DIR=$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd)

# macOS: MacOS/ChisaCode is a sibling of Resources/
# Linux: the executable sits next to resources/. Prefer ChisaCode.bin when present
# because ChisaCode is a GUI wrapper that adds Chromium flags not accepted by
# ELECTRON_RUN_AS_NODE.
if [ -x "${RESOURCES_DIR}/../MacOS/ChisaCode" ]; then
  APP_EXECUTABLE="${RESOURCES_DIR}/../MacOS/ChisaCode"
elif [ -x "${RESOURCES_DIR}/../ChisaCode.bin" ]; then
  APP_EXECUTABLE="${RESOURCES_DIR}/../ChisaCode.bin"
elif [ -x "${RESOURCES_DIR}/../ChisaCode" ]; then
  APP_EXECUTABLE="${RESOURCES_DIR}/../ChisaCode"
else
  echo "Bundled ChisaCode executable not found relative to ${RESOURCES_DIR}" >&2
  exit 1
fi

RUNNER_PATH="${RESOURCES_DIR}/app.asar.unpacked/dist/daemon/node-entrypoint-runner.js"
UNPACKED_CLI_ENTRYPOINT="${RESOURCES_DIR}/app.asar.unpacked/node_modules/@chisacode/cli/dist/index.js"
ASAR_CLI_ENTRYPOINT="${RESOURCES_DIR}/app.asar/node_modules/@chisacode/cli/dist/index.js"

if [ ! -f "$RUNNER_PATH" ]; then
  echo "Bundled ChisaCode node runner not found at ${RUNNER_PATH}" >&2
  exit 1
fi

if [ -f "$UNPACKED_CLI_ENTRYPOINT" ]; then
  CLI_ENTRYPOINT="$UNPACKED_CLI_ENTRYPOINT"
elif [ -f "${RESOURCES_DIR}/app.asar" ]; then
  CLI_ENTRYPOINT="$ASAR_CLI_ENTRYPOINT"
else
  echo "Bundled ChisaCode app archive not found at ${RESOURCES_DIR}/app.asar" >&2
  exit 1
fi

ELECTRON_RUN_AS_NODE=1 CHISACODE_NODE_ENV=production "$APP_EXECUTABLE" \
  --disable-warning=DEP0040 \
  "$RUNNER_PATH" \
  node-script \
  "$CLI_ENTRYPOINT" \
  "$@"
