{
  "name": "@chisacode/app",
  "version": "1.0.3",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "npm --prefix ../.. run build:client && concurrently --kill-others --names protocol,client,expo --prefix-colors yellow,blue,magenta \"npm --prefix ../.. run watch:protocol\" \"npm --prefix ../.. run watch:client\" \"npm run start:expo\"",
    "start:expo": "cross-env APP_VARIANT=development expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "eas-build-post-install": "npm --prefix ../.. run build:app-deps && npm run build:terminal-webview",
    "android": "npm run android:development",
    "android:development": "npm --prefix ../.. run build:client && cross-env APP_VARIANT=development expo prebuild --platform android --non-interactive && cross-env APP_VARIANT=development expo run:android --variant=debug",
    "android:production": "npm --prefix ../.. run build:client && cross-env APP_VARIANT=production expo prebuild --platform android --non-interactive && cross-env APP_VARIANT=production expo run:android --variant=release",
    "android:release": "npm run android:production",
    "android:clear": "node -e \"require('node:fs').rmSync('android', { recursive: true, force: true })\"",
    "ios": "npm --prefix ../.. run build:client && expo run:ios",
    "ios:release": "npm --prefix ../.. run build:client && expo run:ios --configuration Release",
    "web": "npm --prefix ../.. run build:client && concurrently --kill-others --names protocol,client,expo --prefix-colors yellow,blue,magenta \"npm --prefix ../.. run watch:protocol\" \"npm --prefix ../.. run watch:client\" \"npm run web:expo\"",
    "web:expo": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --project browser",
    "test:desktop-packaged": "tsx e2e/desktop-packaged-slices.script.ts",
    "test:e2e": "playwright test --project='Desktop Chrome'",
    "test:e2e:desktop-chain": "playwright test --project='Desktop Chrome' e2e/desktop-updates.spec.ts e2e/workspace-open-in-editor.spec.ts e2e/terminal-protocol-query.spec.ts",
    "test:e2e:real": "playwright test --project=real-provider",
    "test:e2e:ui": "playwright test --ui",
    "build": "npm run build:web",
    "build:web": "npm --prefix ../.. run build:app-deps && expo export --platform web",
    "deploy:web": "npm run build:web && wrangler pages deploy dist --project-name chisacode-app --branch main",
    "build:terminal-webview": "node ./scripts/build-terminal-webview-html.mjs"
  },
  "dependencies": {
    "@chisacode/client": "*",
    "@chisacode/expo-two-way-audio": "*",
    "@chisacode/highlight": "*",
    "@chisacode/protocol": "*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react-native": "^0.10.7",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@gorhom/portal": "^1.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native/normalize-colors": "^0.86.0",
    "@tanstack/react-query": "^5.90.11",
    "@tanstack/react-virtual": "^3.13.21",
    "@xterm/addon-clipboard": "^0.3.0-beta.213",
    "@xterm/addon-fit": "^0.12.0-beta.213",
    "@xterm/addon-image": "^0.10.0-beta.213",
    "@xterm/addon-ligatures": "^0.11.0-beta.213",
    "@xterm/addon-search": "^0.17.0-beta.213",
    "@xterm/addon-unicode11": "^0.10.0-beta.213",
    "@xterm/addon-web-links": "^0.13.0-beta.213",
    "@xterm/addon-webgl": "^0.20.0-beta.212",
    "@xterm/xterm": "^6.1.0-beta.213",
    "buffer": "^6.0.3",
    "expo": "~57.0.4",
    "expo-asset": "~57.0.3",
    "expo-audio": "~57.0.0",
    "expo-blur": "~57.0.0",
    "expo-build-properties": "~57.0.3",
    "expo-camera": "~57.0.1",
    "expo-clipboard": "~57.0.0",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.5",
    "expo-file-system": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-image-manipulator": "~57.0.2",
    "expo-image-picker": "~57.0.2",
    "expo-keep-awake": "~57.0.0",
    "expo-linking": "~57.0.2",
    "expo-notifications": "~57.0.3",
    "expo-router": "~57.0.4",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.3",
    "expo-splash-screen": "~57.0.2",
    "expo-system-ui": "~57.0.0",
    "expo-updates": "~57.0.6",
    "fast-deep-equal": "^3.1.3",
    "html-parse-stringify": "^3.0.1",
    "htmlparser2": "^12.0.0",
    "i18next": "^26.3.0",
    "lucide-react-native": "^0.546.0",
    "markdown-it": "14.2.0",
    "mnemonic-id": "^3.2.7",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.8",
    "react-native": "0.86.0",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-edge-to-edge": "^1.7.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-markdown-display": "^7.0.2",
    "react-native-nitro-modules": "0.35.5",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-uitextview": "^2.2.0",
    "react-native-unistyles": "^3.2.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0",
    "tiny-invariant": "^1.3.3",
    "use-sync-external-store": "^1.6.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/markdown-it": "^14.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.3",
    "@types/ws": "^8.18.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@xterm/headless": "^6.1.0-beta.213",
    "babel-preset-expo": "57.0.2",
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.7",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.0",
    "jsdom": "^20.0.3",
    "material-icon-theme": "^5.32.0",
    "playwright": "^1.56.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0",
    "ws": "8.21.0"
  }
}
